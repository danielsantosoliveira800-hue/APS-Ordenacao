# Scripts Linux: LF
*.sh text eol=lf

# Scripts Windows: CRLF
*.bat text eol=crlf

# Codigo-fonte e configuracoes: LF
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Arquivos de controle do Git: LF
.gitattributes text eol=lf
.gitignore text eol=lf